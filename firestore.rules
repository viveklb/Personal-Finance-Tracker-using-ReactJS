rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/transactions/{transactionId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['name','type','amount','date','category','note'])
          && d.keys().hasOnly(['name','type','amount','date','category','note'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && d.type in ['income','expense']
          && d.amount is number && d.amount > 0 && d.amount <= 10000000000
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.category in ['Salary','Freelance','Investments','Food & dining','Shopping','Transport','Housing','Entertainment','Health','Other']
          && d.note is string && d.note.size() <= 500;
      }
      allow read, delete: if owner();
      allow create, update: if owner() && valid();
    }
  }
}
